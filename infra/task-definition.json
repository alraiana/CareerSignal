{
  "family": "careersignal-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::428192323305:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::428192323305:role/careersignal-task-role",
  "containerDefinitions": [
    {
      "name": "careersignal-app",
      "image": "placeholder",
      "essential": true,
      "portMappings": [{ "containerPort": 8501, "protocol": "tcp" }],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')\" || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/careersignal-app",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
